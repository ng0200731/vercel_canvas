# ──────────────────────────────────────────────────────────────────────────
# Infinite Canvas AI Agent — environment variables
#
# Copy this file to `.env.local` and fill in what you need.
# ALL KEYS ARE OPTIONAL: the app runs in local/demo mode with zero config.
# Add a key to switch that capability on (cloud persistence, auth, AI generation).
# ──────────────────────────────────────────────────────────────────────────

# ── Supabase (optional — enables cloud auth, Postgres persistence, Storage) ──
# Create a project at https://supabase.com → Project Settings → API
# When these are set, local Postgres mode is ignored (cloud wins).
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new Supabase projects. The legacy ANON_KEY name remains supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Local Postgres (optional — durable SQL on this machine, no auth) ──
# Priority: cloud Supabase > local Postgres > browser localStorage.
# 1. Comment out / leave blank the Supabase keys above
# 2. docker compose up -d   (or pnpm db:up)
# 3. Set the flags below and run pnpm db:migrate
# 4. pnpm dev
# Host port 15432 maps to container 5432 (Windows often blocks host 5432 via Hyper-V).
DATABASE_URL=postgresql://canvas:canvas@localhost:15432/canvas_dev
NEXT_PUBLIC_LOCAL_POSTGRES=true
# Fixed owner for all local rows (optional; default shown)
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

# ── Xiangsu AI (optional — enables AI image generation) ──
# Server-only. Rotate any key that has been shared publicly before using it.
XIANGSU_API_KEY=

# Picture Sherlock CLIP reverse-image search (optional, server-only).
# Run the local FastAPI sidecar from services/picture-sherlock (see docs/SETUP.md).
# When unset (or the sidecar is down) and FALLBACK_TO_LOCAL=true, the app uses the
# local histogram embedding matcher instead.
PICTURE_SHERLOCK_URL=http://127.0.0.1:8091
PICTURE_SHERLOCK_TIMEOUT_MS=90000
PICTURE_SHERLOCK_FALLBACK_TO_LOCAL=true

# Milvus-path CLIP reverse-image search (optional, server-only).
# Default on Windows: host Python sidecar with MILVUS_MATCH_BACKEND=numpy
# (no new Docker image). See services/milvus-match/README.md.
# Optional Docker when Hub works: pnpm match:milvus:docker
MILVUS_MATCH_URL=http://127.0.0.1:8092
MILVUS_MATCH_TIMEOUT_MS=90000
MILVUS_MATCH_FALLBACK_TO_LOCAL=true

# the-eland.co LabelStash Partner Search API (optional, server-only).
# Sign in at https://the-eland.co/portal, upload your supplier catalog at
# /portal/upload (one image at a time, then wait for background indexing), and
# create an API key at /portal/keys (shown exactly once — copy it).
# The API searches only images your organization previously uploaded there;
# there is no upload API and no per-supplier filter (narrow with the query box).
ELAND_PORTAL_API_KEY=
ELAND_PORTAL_BASE_URL=https://the-eland.co
ELAND_PORTAL_TIMEOUT_MS=60000
ELAND_PORTAL_TOP_K=10

# SMTP email delivery (optional, server-only)
# Optional local SMTP-catcher override for Mailpit/MailHog. Leave blank to send
# from local development through 163.com first, with Gmail as the fallback.
SMTP_LOCAL_HOST=
SMTP_LOCAL_PORT=
SMTP_LOCAL_SECURE=false
SMTP_LOCAL_USERNAME=
SMTP_LOCAL_PASSWORD=
# 163.com is the primary remote provider. Use the SMTP authorization password,
# not the normal account password.
SMTP_163_USERNAME=
SMTP_163_PASSWORD=
# Gmail is used as a fallback. Use a Google App Password, not the account password.
SMTP_GMAIL_USERNAME=
SMTP_GMAIL_PASSWORD=
# Optional sender display name. The sender address is always the active SMTP username.
SMTP_FROM_NAME=Infinite Canvas

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
